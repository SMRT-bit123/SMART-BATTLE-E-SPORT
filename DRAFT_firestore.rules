rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "XoXyXcnrlzOaMIKKolXnU3mT9xn1" ||
        request.auth.token.get('email', '') == "qupagaming@gmail.com" || 
        request.auth.token.get('email', '') == "mahendrathakur9009@gmail.com" ||
        request.auth.token.get('email', '') == "mahendrar9009@gmail.com"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Specific Collection Rules ---

    // Users: Profiles and wallet information
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['username', 'email', 'wallet']) &&
               data.username is string && data.username.size() <= 100 &&
               data.email is string && data.email.size() <= 200 &&
               data.wallet is map;
      }
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && (
        isAdmin() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'phone', 'wallet', 'stats', 'isKycVerified', 'referralClaimed', 'deviceId'])
        )
      );
    }

    // Games: Public list of supported games
    match /games/{gameId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // Game Rules: Detailed rules for game modes
    match /gameRules/{ruleId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // Matches: The actual tournament/match instances
    match /matches/{matchId} {
      allow read, list, get: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['players', 'playersCount']))
      );
    }

    // Registrations: Player entries into matches
    match /registrations/{registrationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Transactions: Financial audit trail (Immutable)
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Explicitly allow admin to list without filters, or users to list their own data
      allow list: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // App Settings: Global configs
    match /appSettings/{settingId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    // Banners: Promotional banners
    match /banners/{bannerId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    // Match Results: Declared winners and scores
    match /matchResults/{matchId} {
      allow read, list, get: if isSignedIn();
      allow write: if isAdmin();
    }

    // Legacy/Mirror support for tournaments
    match /tournaments/{tournamentId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // Meta/Counters
    match /meta/counters {
      allow read, get, write: if isAdmin();
    }
  }
}
