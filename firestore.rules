rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "XoXyXcnrlzOaMIKKolXnU3mT9xn1" ||
        request.auth.token.email.lower() == "qupagaming@gmail.com" || 
        request.auth.token.email.lower() == "mahendrathakur9009@gmail.com" ||
        request.auth.token.email.lower() == "mahendrar9009@gmail.com" ||
        request.auth.token.email.lower() == "ankushsharma3948@gmail.com"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBannedUser() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGameMode(data) {
      return data.keys().hasAll(['id', 'gameId', 'title', 'image']) &&
             data.id is string && data.id.size() <= 100 &&
             data.gameId is string && data.gameId.size() <= 50 &&
             data.title is string && data.title.size() <= 100 &&
             data.image is string && data.image.size() <= 2500;
    }

    // --- Specific Collection Rules ---

    // Game Modes: Dynamic game mode configurations
    match /gameModes/{modeId} {
      allow read, get, list: if true;
      allow create, update: if isAdmin() && isValidGameMode(request.resource.data);
      allow delete: if isAdmin();
    }

    // Users: Profiles and wallet information
    match /users/{userId} {
      function isValidNewUser(data) {
        return data.keys().hasAll(['username', 'email', 'wallet']) &&
               data.username is string && data.username.size() <= 100 &&
               data.email is string && data.email.size() <= 200 &&
               data.wallet is map &&
               // Security: New players MUST start with 0 coins
               data.wallet.get('deposit', 0) == 0 &&
               data.wallet.get('winnings', 0) == 0 &&
               data.wallet.get('bonus', 0) == 0 &&
               data.get('isBanned', false) == false;
      }

      function isValidUserWalletUpdate(prevWallet, nextWallet) {
        // Security: Non-admin users can ONLY decrease balances (e.g. paying entry fees or withdrawals), NEVER self-grant coins
        return nextWallet is map &&
               nextWallet.get('deposit', 0) <= prevWallet.get('deposit', 0) &&
               nextWallet.get('winnings', 0) <= prevWallet.get('winnings', 0) &&
               nextWallet.get('bonus', 0) <= prevWallet.get('bonus', 0);
      }

      allow get: if true;
      allow list: if true; // Allowed for Leaderboard
      allow create: if isOwner(userId) && isValidNewUser(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && (
        isAdmin() || (
          // Banned users cannot update their profile
          !isBannedUser() &&
          // Cannot modify administrative, ban status, or role fields
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isBanned', 'banReason', 'bannedAt', 'bannedBy']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'phone', 'wallet', 'stats', 'isKycVerified', 'referralClaimed', 'deviceId', 'ign', 'gameIGNs']) &&
          isValidUserWalletUpdate(resource.data.wallet, request.resource.data.wallet)
        )
      );
    }

    // Games: Public list of supported games
    match /games/{gameId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // Game Rules: Detailed rules for game modes
    match /gameRules/{ruleId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // Matches: The actual tournament/match instances
    match /matches/{matchId} {
      allow read, list, get: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isSignedIn() && !isBannedUser() && (
        isAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['players', 'playersCount'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['roomId', 'roomPassword', 'roomReleaseTime', 'status', 'updatedAt']))
      );
    }

    // Hosts: Host account permissions and assignments
    match /hosts/{hostId} {
      allow read, get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Host Logs: Audit trail for host actions (Immutable)
    match /hostLogs/{logId} {
      allow read, list, get: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Admin Logs: Audit trail for admin ban/unban and financial adjustments (Immutable)
    match /adminLogs/{logId} {
      allow read, list, get: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Registrations: Player entries into matches
    match /registrations/{registrationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Security: Banned users cannot join matches
      allow create: if isSignedIn() && !isBannedUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isOwner(resource.data.userId) && !isBannedUser() && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin() || (isSignedIn() && !isBannedUser() && resource.data.userId == request.auth.uid);
    }

    // Transactions: Financial audit trail (Immutable)
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Allowed for Leaderboard and personal view
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.type == 'win'
      );
      // Security: Banned users cannot create transactions
      allow create: if isSignedIn() && !isBannedUser() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // App Settings: Global configs
    match /appSettings/{settingId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    // Banners: Promotional banners
    match /banners/{bannerId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    // Match Results: Declared winners and scores
    match /matchResults/{matchId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // Payment Settings: Gateway configurations
    match /paymentSettings/{gatewayId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    // Notifications: Push alerts & broadcast messages
    match /notifications/{notificationId} {
      allow read, get, list: if true;
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
    }

    // Legacy/Mirror support for tournaments
    match /tournaments/{tournamentId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // Meta/Counters
    match /meta/counters {
      allow read, get, write: if isAdmin();
    }
  }
}
